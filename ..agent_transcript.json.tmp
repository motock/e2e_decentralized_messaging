lient's stored identity key is detected by the other party's safety-number check\n     6\t\n     7\tuse core_crypto::identity::IdentityKeyPair;\n     8\tuse core_protocol::session::establish_session;\n     9\tuse core_protocol::message::encrypt_for_session;\n    10\t\n    11\t#[test]\n    12\tfn two_clients_exchange_and_decrypt_verified_message() {\n    13\t    let alice = IdentityKeyPair::generate();\n    14\t    let bob = IdentityKeyPair::generate();\n    15\t\n    16\t    let session = establish_session(&alice, &bob.public()).expect(\"session established\");\n    17\t    let ciphertext = encrypt_for_session(&session, b\"hello bob, verified!\").expect(\"encrypt\");\n    18\t    let plaintext = session.decrypt(&ciphertext).expect(\"decrypt\");\n    19\t    assert_eq!(plaintext, b\"hello bob, verified!\");\n    20\t}\n    21\t\n    22\t#[test]\n    23\tfn tampered_identity_key_is_detected_by_safety_number_change() {\n    24\t    let alice = IdentityKeyPair::generate();\n    25\t    let bob = IdentityKeyPair::generate();\n    26\t\n    27\t    let session = establish_session(&alice, &bob.public()).expect(\"session established\");\n    28\t    let initial_safety_number = session.safety_number();\n    29\t\n    30\t    // Bob's stored identity key is tampered with (replaced with a new key).\n    31\t    let bob_tampered = IdentityKeyPair::generate();\n    32\t    let tampered_safety_number =\n    33\t        core_protocol::session::compute_safety_number(&alice.public(), &bob_tampered.public());\n    34\t\n    35\t    assert_ne!(\n    36\t        initial_safety_number, tampered_safety_number,\n    37\t        \"tampered identity key MUST produce a different safety number\"\n    38\t    );\n    39\t}\n"}, {"role": "tool", "content": "vitest.config.ts (1:373) \u001b[33m[UNRESOLVED_IMPORT] \u001b[0mCould not resolve 'vitest/config' in vitest.config.ts\n - Module not found, treating it as an external dependency in vitest.config.ts at 373..388\n\nvitest.config.ts (2:17) \u00