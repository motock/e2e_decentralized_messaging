/target
# Relay durable state: the on-disk store the WS bridge writes when the
# operator configures --store-path (RD-3). Never commit operator state.
/relay-state/
*.sqlite
*.sqlite-shm
*.sqlite-wal
# Generated by tauri-build at compile time (permission/capability schemas) — not source.
/clients/desktop-tauri/gen/
node_modules/
# Generated by `npm run prepare-wasm` (wasm-pack build --out-dir pkg, resolved
# relative to the crate path, not the invoking cwd) — not source.
/core/bindings/wasm/pkg/
# Generated by `npm run build` (vite build) in the web client — the static
# bundle published as a CI artifact, not source.
/clients/web/dist/
